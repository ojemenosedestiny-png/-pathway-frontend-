NODE_ENV=development
PORT=3000
# Server-side fixed API upstream. The browser calls /backend-api on the website origin.
PATHWAY_BACKEND_ORIGIN=https://pathway-backend-892m.onrender.com
DATABASE_PATH=./data/newworldpathway.sqlite
# Future payment adapters only: these are public identifiers, not secret keys.
# Do not place provider secret keys in frontend code.
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_PUBLIC_KEY=
STRIPE_PUBLISHABLE_KEY=
# Future backend integrations (never expose these to the browser):
PUBLIC_SITE_ORIGIN=http://localhost:3000
SESSION_SECRET=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Server-only owner bootstrap. No default credentials. Remove the initial password after seeding.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
STUDENT_ID_PREFIX=PU
STUDENT_ID_START_NUMBER=1
